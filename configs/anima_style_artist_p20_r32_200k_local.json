{
  "initialization": "pretrained",
  "auto_resume": true,
  "content_loss": "flow_l2",
  "cache_latents": false,
  "cache_latents_to_disk": false,
  "vae_batch_size": 1,
  "data": {
    "artist_index": "work/danbooru-0000-0101-p20",
    "index_cache_bytes": 0,
    "index_fetch_workers": 2,
    "datasets": [
      {
        "batch_size": 1,
        "resolution": [
          512,
          512
        ],
        "max_pixels": 262144,
        "enable_bucket": true,
        "min_bucket_reso": 256,
        "max_bucket_reso": 1536,
        "bucket_reso_steps": 64,
        "bucket_no_upscale": true,
        "max_aspect_ratio": 3.0,
        "repeat": true,
        "shuffle_buffer": 0,
        "shuffle_caption": true,
        "resize_interpolation": "area",
        "subsets": [
          {}
        ]
      }
    ],
    "artist_sampling": "artist_cycle"
  },
  "reference_adapter": {
    "format": "snapref_v1a",
    "path": "work/anima-svd-r32-512/init/snapref-v2a-r32-r32.safetensors",
    "mode": "cs"
  },
  "seed": 42,
  "dtype": "bfloat16",
  "gradient_checkpointing": true,
  "checkpoint_blocks": null,
  "max_prompt_length": 512,
  "offload_text_encoder": true,
  "assets_manifest": "work\\anima-artist-p20-r32-200k\\train.assets.json",
  "tagger": {
    "repo_id": "Bedovyy/OppaiOracle-V1.1-timm",
    "revision": "main",
    "dtype": "bfloat16",
    "max_tags": 256,
    "prompt_categories": [
      "general"
    ],
    "thresholds": {
      "general": 0.75,
      "character": 1.0,
      "copyright": 1.0,
      "style": 1.0,
      "meta": 1.0,
      "rating": 1.0
    },
    "preprocessing": {
      "color_space": "BGR",
      "pad_color": 114
    }
  },
  "noise": {
    "distribution": "progress_logit_normal",
    "mean": -2.36,
    "std": 1.3
  },
  "sampling": {
    "enabled": true,
    "every_n_steps": 300,
    "at_end": true,
    "num_pairs": 3,
    "steps": 30,
    "pair_source": "random",
    "vae_decode_device": "cpu",
    "guidance_scale": 3.0,
    "flow_shift": 5.0,
    "jpeg_quality": 95,
    "preview_max_side": 0
  },
  "training": {
    "max_steps": 200000,
    "batch_size": 1,
    "gradient_accumulation_steps": 1,
    "optimizer_type": "AdamW8bit",
    "learning_rate": 3e-05,
    "optimizer_args": [
      "weight_decay=0.01",
      "betas=(0.9, 0.999)",
      "eps=1e-8"
    ],
    "lr_scheduler": "cosine_cycles",
    "warmup_steps": 1000,
    "lr_cycles": 5,
    "min_lr_ratio": 0.01,
    "num_workers": 0,
    "prefetch_batches": 2,
    "content_weight": 1.0,
    "style_weight": 0.0,
    "max_grad_norm": 1.0,
    "save_every": 300,
    "keep_last_checkpoints": 3,
    "tensorboard": true,
    "history_limit": 1000,
    "resume_data_mode": "reseed",
    "log_timing": true,
    "log_stage_timing": false
  },
  "architecture": "anima",
  "adapter": {
    "ref": {
      "rank": 32,
      "alpha": 32
    },
    "tgt": {
      "rank": 32,
      "alpha": 32
    }
  },
  "tag_cache": "work/danbooru-0000-0101-p20/tags-oppai-v1_1/tag-cache.json",
  "checkpoint_cpu_offload": true,
  "trim_text_padding": true,
  "reference_dropout": {
    "enabled": false
  },
  "latent_pair_filter": {
    "enabled": true,
    "method": "classifier",
    "model": "configs/anima_pair_classifier.json",
    "min_score": 0.95,
    "max_rejections": 256
  },
  "attn_mode": "flash",
  "tag_retention": {
    "distribution": "beta",
    "alpha": 5.0,
    "beta": 2.0
  },
  "vae_encoder_only": true
}
