{
  "initialization": "pretrained",
  "auto_resume": true,
  "content_loss": "flow_l2",
  "cache_latents": true,
  "cache_latents_to_disk": true,
  "vae_batch_size": 1,
  "latent_cache_dir": "work/anima-1000-p10-512-all-paired/latents",
  "latent_cache": {
    "reserve_ram_gib": 8,
    "precomputed_dir": "work/anima-1000-p10-512-all-paired/latents",
    "load_to_memory": false
  },
  "data": {
    "datasets": [
      {
        "batch_size": 1,
        "resolution": [
          512,
          512
        ],
        "enable_bucket": true,
        "max_pixels": 262144,
        "min_bucket_reso": 256,
        "max_bucket_reso": 1536,
        "bucket_reso_steps": 64,
        "bucket_no_upscale": false,
        "max_aspect_ratio": 3.0,
        "repeat": true,
        "shuffle_buffer": 0,
        "shuffle_caption": true,
        "resize_interpolation": "area",
        "subsets": [
          {
            "caption_tag_dropout_rate": 0.1
          }
        ]
      }
    ],
    "artist_index": "artists-1000-p10-all-paired",
    "index_cache_bytes": 0,
    "artist_sampling": "artist_cycle"
  },
  "reference_adapter": null,
  "seed": 42,
  "dtype": "bfloat16",
  "gradient_checkpointing": true,
  "checkpoint_blocks": null,
  "max_prompt_length": 512,
  "offload_text_encoder": true,
  "assets_manifest": "work/anima-snapref-v2a-512/train.assets.json",
  "tagger": {
    "dtype": "bfloat16",
    "max_tags": 256,
    "prompt_categories": [
      "general",
      "character",
      "copyright"
    ],
    "thresholds": {
      "general": 0.17,
      "character": 0.27,
      "style": 0.15,
      "copyright": 0.24,
      "meta": 0.17,
      "rating": 0.41
    }
  },
  "noise": {
    "distribution": "progress_logit_normal",
    "mean": -3.45,
    "std": 1.35
  },
  "sampling": {
    "enabled": true,
    "every_n_steps": 300,
    "at_end": true,
    "num_pairs": 3,
    "steps": 30,
    "pair_source": "random",
    "vae_decode_device": "cpu",
    "guidance_scale": 3.0,
    "flow_shift": 5.0,
    "jpeg_quality": 95,
    "preview_max_side": 0
  },
  "training": {
    "max_steps": 20000,
    "batch_size": 1,
    "gradient_accumulation_steps": 1,
    "optimizer_type": "AdamW8bit",
    "learning_rate": 3e-05,
    "optimizer_args": [
      "weight_decay=0.01",
      "betas=(0.9, 0.999)",
      "eps=1e-8"
    ],
    "lr_scheduler": "cosine_cycles",
    "warmup_steps": 0,
    "lr_cycles": 5,
    "min_lr_ratio": 0.01,
    "num_workers": 0,
    "prefetch_batches": 2,
    "content_weight": 1.0,
    "style_weight": 0.0,
    "max_grad_norm": 1.0,
    "save_every": 300,
    "keep_last_checkpoints": 3,
    "tensorboard": true,
    "history_limit": 1000,
    "resume_data_mode": "reseed",
    "log_timing": true,
    "log_stage_timing": false
  },
  "architecture": "anima",
  "adapter": {
    "ref": {
      "rank": 32,
      "alpha": 32
    },
    "tgt": {
      "rank": 32,
      "alpha": 32
    }
  },
  "tag_cache": "work/anima-1000-p10-512-all-paired/tags/tag-cache.json",
  "checkpoint_cpu_offload": true,
  "trim_text_padding": true,
  "reference_dropout": {
    "enabled": false
  },
  "latent_pair_filter": {
    "enabled": true,
    "method": "classifier",
    "model": "work/anima-pair-classifier-20261124/pair_classifier.json",
    "scores": "work/anima-pair-classifier-20261124/pair_filter_scores.npz",
    "min_score": 0.95
  },
  "attn_mode": "flash",
  "reference_stream": {
    "blocks": 7,
    "cross_attention": false,
    "trainable_mode": false
  }
}
